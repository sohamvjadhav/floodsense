   "source": [
    "# FloodSense: Example Workflow\n",
    "\n",
    "This notebook demonstrates the full FloodSense pipeline from data "
    "setup to model training.\n",
    "\n",
    "## Setup\n",
    "\n",
    "```bash\n",
    "# Create virtual environment\n",
    "python3 -m venv .venv\n",
    "\n",
    "## Install requirements\n",
    ".venv/bin/pip install -r ../requirements.txt\n",
    "\n",
    "## Build the dataset\n",
    ".venv/bin/python -m src.data.build_dataset --years 5\n",
    "```\n",
    "\n",
    "## Train the baseline stacking classifier\n",
    "\n",
    "```bash\n",
    ".venv/bin/python -m src.models.baseline_stacking\n",
    "```\n",
    "\n",
    "## Train the GRU sequence model\n",
    "\n",
    "```bash\n",
    ".venv/bin/python -m src.models.sequence_model --epochs 12\n",
    "```\n",
    "\n",
    "## View results\n",
    "\n",
    "- Baseline metrics: `docs/baseline_metrics.json`\n",
    "- Sequence model metrics: `docs/sequence_metrics.json`\n",
    "- Calibration metrics: `docs/calibration_metrics.json`\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quick verification that the pipeline works\n",
    "import pandas as pd\n",
    "from src.data.stations import STATION_BY_ID\n",
    "\n",
    "n_stations = len(STATION_BY_ID)\n",
    "print(f\"Station registry: {n_stations} stations\")\n",
    "\n",
    "# Check station basins\n",
    "basins = set(s['basin'] for s in STATION_BY_ID.values())\n",
    "print(f\"Basins: {sorted(basins)}\")\n",
    "\n",
    "# Verify upstream adjacency\n",
    "for sid, s in list(STATION_BY_ID.items())[:3]:\n",
    "    print(f\"  {sid}: upstream={s['upstream_ids']}\")"
   ]
  }
